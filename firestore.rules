rules_version = '2';
// قواعد «دفتر العملاء» — مشروع clientbook لوحده (منفصل عن البصمة)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // المالك: أول حساب اتعمل في التطبيق
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/meta/owner)
      && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid; }
    function uDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && uDoc().data.active == true; }
    function isStaff() { return isOwner() || isUser(); }
    function isSender() { return isOwner() || (isUser() && uDoc().data.role == 'sender'); }

    // المالك: بيتسجل مرة واحدة بس، أول مرة يتفتح فيها التطبيق
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // الحسابات: المالك بس اللي يضيف ويوقف
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create: if isOwner() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'owner'
        && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid);
      allow update, delete: if isOwner() && uid != request.auth.uid;
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isSender();
    }
    // العملاء: رقم الجوال هو اسم المستند، فمستحيل يتكرر
    match /clients/{phone} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.phone == phone && phone.matches('^[0-9]{10,15}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow update: if isStaff() && request.resource.data.phone == resource.data.phone;
      allow delete: if isSender();
    }
    // الإعلانات
    match /campaigns/{id} {
      allow read, write: if isSender();
    }
    // سجل الإرسال: مين اتبعتله أنهي إعلان
    match /sent/{id} {
      allow read: if isSender();
      allow create: if isSender() && id == request.resource.data.camp + '_' + request.resource.data.cid;
      allow delete: if isSender();
    }
  }
}
